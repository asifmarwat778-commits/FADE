"""
DTR - 7 Metrics + Predicted vs Experimental Figure
Metrics: R2, RMSE, MAE, KGE, d, E1, MBE
Font: Times New Roman, 20pt
Mode: test
"""

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use('TkAgg')
import matplotlib.pyplot as plt
from matplotlib import rcParams
from sklearn.tree import DecisionTreeRegressor
from sklearn.model_selection import train_test_split, GridSearchCV, KFold
from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error
import warnings
warnings.filterwarnings('ignore')

# ==================== CONFIG ====================
MODE = 'combined'

FILE_PATH = r"D:\HIT Research\Research Paper 2\ML data\Data2026042605 ONP HOCl.csv"
FEATURE_COLS = ['UV254(mJ cm-2)', 'HOCl(mg/L)', 'Fe3+ (mg/L)', 'pH', 'NB (micromolar)',
                'MeOH(mM)', 'ONP(mg/L)', 'NO2-(mM)', 'HCO3-(mM)', 'Cl-(mM)', 'SO42-(mM)']
TARGET_COL = 'Kobs (min-1)'
TEST_SIZE = 0.2
RANDOM_STATE = 42
# ================================================

# Times New Roman, 20pt
rcParams['font.family'] = 'serif'
rcParams['font.serif'] = ['Times New Roman']
rcParams['font.size'] = 20
rcParams['axes.titlesize'] = 20
rcParams['axes.labelsize'] = 20
rcParams['xtick.labelsize'] = 20
rcParams['ytick.labelsize'] = 20
rcParams['legend.fontsize'] = 18

# Load data
df = pd.read_csv(FILE_PATH)
X = df[FEATURE_COLS].values
y = df[TARGET_COL].values
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=TEST_SIZE, random_state=RANDOM_STATE)

# Select data
if MODE == 'train':
    X_fit, y_fit = X_train, y_train
    X_eval, y_eval = X_train, y_train
elif MODE == 'test':
    X_fit, y_fit = X_train, y_train
    X_eval, y_eval = X_test, y_test
else:
    X_fit, y_fit = X_train, y_train
    X_eval, y_eval = X, y

# DTR GridSearch
param_grid = {
    'max_depth': [3, 5, 8, 10, None],
    'min_samples_split': [2, 5, 10],
    'min_samples_leaf': [1, 2, 4],
}

dtr = DecisionTreeRegressor(random_state=RANDOM_STATE)
grid = GridSearchCV(dtr, param_grid, scoring='neg_root_mean_squared_error',
                    cv=KFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE), n_jobs=-1, verbose=0)
grid.fit(X_fit, y_fit)
model = grid.best_estimator_

# Predict
y_pred = model.predict(X_eval)
y_obs = y_eval

# Metrics
def willmott_d(yt, yp):
    yt, yp = np.asarray(yt).flatten(), np.asarray(yp).flatten()
    om = np.mean(yt)
    num = np.sum((yp - yt) ** 2)
    den = np.sum((np.abs(yp - om) + np.abs(yt - om)) ** 2)
    return 1 - num / den if den != 0 else 1.0

def kge(yt, yp):
    yt, yp = np.asarray(yt).flatten(), np.asarray(yp).flatten()
    r = np.corrcoef(yt, yp)[0, 1]
    a = np.std(yp) / np.std(yt)
    b = np.mean(yp) / np.mean(yt)
    return 1 - np.sqrt((r - 1) ** 2 + (a - 1) ** 2 + (b - 1) ** 2)

def legates_e1(yt, yp):
    yt, yp = np.asarray(yt).flatten(), np.asarray(yp).flatten()
    om = np.mean(yt)
    num = np.sum(np.abs(yt - yp))
    den = np.sum(np.abs(yt - om))
    return 1 - num / den if den != 0 else 1.0

r2 = r2_score(y_obs, y_pred)
rmse = np.sqrt(mean_squared_error(y_obs, y_pred))
mae = mean_absolute_error(y_obs, y_pred)
kge_val = kge(y_obs, y_pred)
d_val = willmott_d(y_obs, y_pred)
e1_val = legates_e1(y_obs, y_pred)
mbe_val = np.mean(y_pred - y_obs)

# Print metrics
print("R2 = {:.4f}".format(r2))
print("RMSE = {:.6f}".format(rmse))
print("MAE = {:.6f}".format(mae))
print("KGE = {:.4f}".format(kge_val))
print("d = {:.4f}".format(d_val))
print("E1 = {:.4f}".format(e1_val))
print("MBE = {:.6f}".format(mbe_val))

# Figure
fig, ax = plt.subplots(figsize=(8, 7))
ax.scatter(y_obs, y_pred, c='#F18F01', edgecolors='k', s=80, alpha=0.75, zorder=3)
min_val = min(y_obs.min(), y_pred.min())
max_val = max(y_obs.max(), y_pred.max())
pad = (max_val - min_val) * 0.05
ax.plot([min_val - pad, max_val + pad], [min_val - pad, max_val + pad], 'r--', lw=2, label='1:1 Line', zorder=2)
ax.set_xlim(min_val - pad, max_val + pad)
ax.set_ylim(min_val - pad, max_val + pad)
ax.set_xlabel('Experimental $k_{obs}$ (min$^{-1}$)')
ax.set_ylabel('Predicted $k_{obs}$ (min$^{-1}$)')
ax.set_title('DTR ({}) | R$^{{2}}$ = {:.4f} | KGE = {:.4f}'.format(MODE.capitalize(), r2, kge_val))
ax.legend()
ax.grid(True, alpha=0.3, zorder=1)
plt.tight_layout()
plt.savefig(FILE_PATH.rsplit('\\', 1)[0] + '\\DTR_Predicted_vs_Experimental_{}.png'.format(MODE), dpi=300, bbox_inches='tight')
plt.show()